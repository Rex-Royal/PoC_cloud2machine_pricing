{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": false,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "allowImportingTsExtensions": true,
    "paths": {
      "#firmware-core": ["./packages/firmware-core/src/index.ts"],
      "#firmware-core/*": ["./packages/firmware-core/src/*"],
      "#cloud-client": ["./packages/cloud-client/src/index.ts"],
      "#cloud-client/*": ["./packages/cloud-client/src/*"],
      "#fleet-sync": ["./packages/fleet-sync/src/index.ts"],
      "#fleet-sync/*": ["./packages/fleet-sync/src/*"]
    },
    "plugins": [
      {
        "name": "next"
      }
    ]
  },
  "include": ["next-env.d.ts", "src/**/*.ts", "src/**/*.tsx", "packages/**/*.ts", "examples/**/*.ts", "tests/**/*.ts", ".next/types/**/*.ts"],
  "exclude": ["node_modules"]
}
